POSTGRES_DB=originpulse
POSTGRES_USER=originpulse
POSTGRES_PASSWORD=originpulse_dev_password
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_IO_METHOD=worker
ORIGINPULSE_BIND_HOST=127.0.0.1
ORIGINPULSE_PORT=8080
ORIGINPULSE_INGEST_INTERVAL=1m

# Required host files; Compose mounts them into the API and collector.
PANTHEON_SSH_KEY_FILE=C:/Users/example/.ssh/id_rsa
# The file may have no entries in automatic mode; its path is always required.
PANTHEON_KNOWN_HOSTS_FILE=C:/Users/example/.ssh/known_hosts
# Automatically trust and persist new or changed server keys in the app data volume.
PANTHEON_AUTO_UPDATE_HOST_KEYS=true

# Optional Pantheon/API and notification settings.
PANTHEON_EMAIL=
PANTHEON_MACHINE_TOKEN=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=10m
ORIGINPULSE_SMTP_USERNAME=
ORIGINPULSE_SMTP_PASSWORD=
ORIGINPULSE_PUSH_WEBHOOK_URLS=
ORIGINPULSE_VAPID_PUBLIC_KEY=
ORIGINPULSE_VAPID_PRIVATE_KEY=
ORIGINPULSE_VAPID_SUBJECT=mailto:originpulse@localhost
LOG_LEVEL=info
